# ============================================================
# 灵犀智能客服 - 环境变量示例
# 复制为 .env 后按需修改；docker compose 部署时部分变量会被
# docker-compose.yml 的 environment 覆盖（指向容器服务名）。
# 字段名必须与 backend/app/config.py 的 Settings 字段严格一致。
# ============================================================

# ---------- 项目基础 ----------
PROJECT_NAME=灵犀智能客服
VERSION=1.0.0
DEBUG=False
# 生产环境务必修改 SECRET_KEY（JWT 签名密钥）
SECRET_KEY=change-this-to-a-random-long-string-in-production
API_V1_STR=/api/v1

# ---------- PostgreSQL ----------
# docker 部署时 POSTGRES_HOST 会被 compose 覆盖为 'postgres'
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lingxi_support
POSTGRES_USER=lingxi
POSTGRES_PASSWORD=lingxi123456

# ---------- Redis ----------
# docker 部署时 REDIS_HOST 会被 compose 覆盖为 'redis'
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Qdrant 向量数据库 ----------
# docker 部署时 QDRANT_HOST 会被 compose 覆盖为 'qdrant'
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ---------- Celery ----------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- 大模型 API ----------
# 必填：填你自己的 LLM 服务地址与 API Key
# 例：DeepSeek 官方 / 阿里灵积 / 智谱 / 私有化 new-api 面板
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-real-api-key-here
LLM_MODEL=deepseek-chat
LLM_MODEL_STRONG=deepseek-chat

# ---------- Embedding 服务 ----------
# docker 部署时 EMBEDDING_HOST 会被 compose 覆盖为 'encoder'
# encoder 服务加载 BAAI/bge-small-zh-v1.5 模型，输出 512 维向量
EMBEDDING_HOST=encoder
EMBEDDING_PORT=8001

# ---------- JWT ----------
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- 会话配置 ----------
# 用户无消息多少秒后推送评价卡片并结束会话
SESSION_TIMEOUT=300
EVAL_PUSH_DELAY=300

# Git 与 IDE
.git
.gitignore
.github
.vscode
.idea

# 敏感配置（含 LLM_API_KEY 等真实 key，绝不能进镜像）
.env
*.env
backend/.env
encoder/.env
frontend/.env

# Docker 自身文件
Dockerfile
docker-compose.yml
.dockerignore

# 文档与示例（不需要进镜像）
*.md
docs/
sql/
scripts/

# Python 缓存与构建产物
__pycache__/
*.py[oc]
*.egg-info
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# 虚拟环境（体积大且不需要进镜像）
.venv/
venv/
env/

# 前端依赖与构建产物（构建阶段会重新 npm ci + npm build）
frontend/node_modules/
frontend/dist/
frontend/.vite/

# 上传文件（运行时挂载，不进镜像）
uploads/

# 测试与本地脚本
backend/tests/
backend/reindex.py
backend/run.bat
backend/start_backend.ps1
backend/start_server.sh

# 模型缓存（encoder 镜像 build 时自己下载，不入库）
.cache/
huggingface/
